rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ВАЖНО: замени значение UID на свой UID из admin.html
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'PASTE_YOUR_FIREBASE_AUTH_UID_HERE'
        && request.auth.token.email_verified == true;
    }
    match /workers/{workerId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /meta/site {
      allow read: if true;
      allow write: if isOwner();
    }
    // Админка проверяет право доступа запросом к несуществующему документу.
    // Владелец получает exists=false; все остальные permission-denied.
    match /internal/{document} {
      allow get: if isOwner();
      allow list, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
