rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function owner(){return signedIn() && request.auth.uid=='PASTE_YOUR_FIREBASE_AUTH_UID_HERE' && request.auth.token.email_verified==true;}
  function validProfileEdit(){
   return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio'])
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size()>=1
    && request.resource.data.displayName.size()<=40
    && request.resource.data.bio is string
    && request.resource.data.bio.size()<=300;
  }
  match /workers/{id}{allow read:if true;allow write:if owner();}
  match /levels/{id}{allow read:if true;allow write:if owner();}
  match /meta/site{allow read:if true;allow write:if owner();}
  match /profiles/{uid}{
   allow read:if true;
   allow create,delete:if false;
   allow update:if signedIn() && request.auth.uid==uid && validProfileEdit();
  }
  match /achievements/{id}{allow read:if true;allow write:if false;}
  match /internal/{id}{allow get:if owner();allow list,write:if false;}
  match /{document=**}{allow read,write:if false;}
 }
}
